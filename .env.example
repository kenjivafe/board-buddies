# Rooms — playing across devices.
#
# Without these two, Board Buddies still runs: every game works in one-phone
# mode and the "our own devices" option is shown disabled. Nothing else breaks.
#
# Create a free Redis database at https://console.upstash.com and copy its
# REST credentials here (or into Vercel's environment variables).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How often a live room re-checks for changes, in milliseconds.
#
# Upstash counts commands, and its free tier allows 10,000 a day. Each watching
# device costs one command per interval, so four players for twenty minutes at
# the default 1500ms is roughly 3,200 commands. Raise this to stretch the free
# tier; lower it for snappier play on a paid plan.
# ROOM_POLL_MS=1500
